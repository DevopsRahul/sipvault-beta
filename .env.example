# =====================================================================
# SipVault environment file
# Copy to ".env" and fill in real values:   cp .env.example .env
# NEVER commit .env to git (it is in .gitignore).
# =====================================================================

# ---------- Public address ----------
# Domain Caddy requests an HTTPS certificate for (DNS A-record must point to the server).
# To test on a bare IP without a domain use:  DOMAIN=:80
DOMAIN=sipvault.example.com
# Full public URL of the app. Printed inside the table QR codes.
APP_URL=https://sipvault.example.com

# ---------- Auth (Auth.js / NextAuth) ----------
# Generate with:  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true

# ---------- PostgreSQL (container) ----------
POSTGRES_USER=sipvault
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=sipvault
# Used only for LOCAL development (npm run dev). docker-compose.yml overrides it
# to point at the "postgres" container. In PROD with RDS, set it to the RDS endpoint.
DATABASE_URL=postgresql://sipvault:replace-with-strong-db-password@localhost:5432/sipvault?schema=public

# ---------- Redis (live order updates) ----------
# Local dev value. docker-compose.yml overrides it to redis://redis:6379
REDIS_URL=redis://localhost:6379

# ---------- File storage ----------
# BETA: local  -> images saved on the server's Docker volume, served by Caddy at /media
# PROD: s3     -> images saved to S3, served by CloudFront
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Where browsers load images from. BETA: /media   PROD: https://cdn.yourdomain.com
MEDIA_BASE_URL=/media

# ---------- S3 / CloudFront (PROD only, leave empty for beta) ----------
AWS_REGION=ap-south-1
S3_BUCKET=
# Build-time only: CDN URL for Next.js JS/CSS bundles
ASSET_PREFIX=

# ---------- Business settings ----------
# mock = no real money (beta testing). Replace with razorpay/stripe later (README section 9).
PAYMENT_PROVIDER=mock
CURRENCY=INR
LEGAL_DRINKING_AGE=21
DISPLAY_TIMEZONE=Asia/Kolkata

# ---------- Seed data (npm run db:seed) ----------
SEED_ADMIN_EMAIL=admin@sipvault.local
SEED_ADMIN_PASSWORD=ChangeMe@123
# true = also create a demo bar, demo owner, demo customer, products and tables
SEED_DEMO=true

# ---------- Backups (optional) ----------
# e.g. backupuser@203.0.113.10:/backups/sipvault/   (copies backups off the server)
BACKUP_RSYNC_TARGET=
